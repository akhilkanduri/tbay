{
    "name": "tbay",
    "dockerComposeFile": "docker-compose.yml",
    "service": "dev",
    "workspaceFolder": "/workspaces/tbay",
    "postCreateCommand": "pip install --user uv && uv sync --all-extras",
    "forwardPorts": [8787],
    "portsAttributes": {
        "8787": {
            "label": "tbay monitor"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/workspaces/tbay/.venv/bin/python"
            }
        }
    }
}
